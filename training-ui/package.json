{
    "name": "anima-training-ui",
    "version": "1.0.0",
    "description": "Web UI for Anima LoRA Training",
    "main": "server.js",
    "scripts": {
        "prestart": "node scripts/ensure-frontend.js",
        "start": "node server.js",
        "dev": "node server.js",
        "test": "node --test tests/*.test.js",
        "build": "node scripts/ensure-frontend.js --force",
        "dev:ui": "npm --prefix frontend run dev",
        "test:ui": "npm --prefix frontend test"
    },
    "dependencies": {
        "express": "^4.18.2",
        "ws": "^8.16.0",
        "@iarna/toml": "^2.2.5"
    }
}
